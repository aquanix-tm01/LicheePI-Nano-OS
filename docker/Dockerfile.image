# Fast rebuild on top of the base image: re-applies br2-external changes
# (kernel/U-Boot config, DTS, patches, overlay) without rebuilding the toolchain.
ARG BASE_IMAGE=licheepi-nano-base
ARG BASE_VERSION=latest

FROM $BASE_IMAGE:$BASE_VERSION AS local

# replace the external tree (deleted files must not linger from the base)
RUN rm -rf /root/licheepi-nano
COPY br2-external/ /root/licheepi-nano/
RUN chmod +x /root/licheepi-nano/board/licheepi_nano/post-image.sh

WORKDIR /root/buildroot
RUN BR2_EXTERNAL=/root/licheepi-nano make licheepi_nano_defconfig

# force rebuild of packages that depend on files in br2-external
RUN rm -rf output/build/uboot-* output/build/.uboot-*
RUN rm -f output/build/host-uboot-tools-*/.stamp_built output/build/host-uboot-tools-*/.stamp_*installed
RUN rm -f output/build/linux-custom/.stamp_dotconfig output/build/linux-custom/.stamp_configured \
          output/build/linux-custom/.stamp_built output/build/linux-custom/.stamp_*installed
RUN rm -f output/build/linux-firmware-*/.stamp_built output/build/linux-firmware-*/.stamp_*installed

RUN make

FROM scratch AS localout
COPY --from=local /root/buildroot/output/images/ .
